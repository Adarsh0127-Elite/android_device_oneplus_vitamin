<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/device_settings_title">

    <!-- Display -->
    <PreferenceCategory
        android:key="category_display"
        android:title="@string/category_display">

        <Preference
            android:key="pref_dc_dimming"
            android:title="@string/dc_dimming_title"
            android:summary="@string/dc_dimming_summary"
            android:icon="@drawable/ic_dc_dimming">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="org.settings.oplusparts"
                android:targetClass="org.settings.oplusparts.display.DcDimmingActivity" />
        </Preference>

        <Preference
            android:key="pref_refresh_rate"
            android:title="@string/refresh_rate_title"
            android:summary="@string/refresh_rate_summary"
            android:icon="@drawable/ic_refresh_rate">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="org.settings.oplusparts"
                android:targetClass="org.settings.oplusparts.refreshrate.RefreshRateActivity" />
        </Preference>
    </PreferenceCategory>

    <!-- Charging -->
    <PreferenceCategory
        android:key="category_charging"
        android:title="@string/category_charging">

        <Preference
            android:key="pref_gentle_charging"
            android:title="@string/gentle_charging_title"
            android:summary="@string/gentle_charging_summary"
            android:icon="@drawable/ic_gentle_charging">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="org.settings.oplusparts"
                android:targetClass="org.settings.oplusparts.power.GentleChargingActivity" />
        </Preference>

        <Preference
            android:key="pref_pause_charging"
            android:title="@string/pause_charging_title"
            android:summary="@string/pause_charging_summary"
            android:icon="@drawable/ic_pause_charging">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="org.settings.oplusparts"
                android:targetClass="org.settings.oplusparts.power.PauseChargingActivity" />
        </Preference>
    </PreferenceCategory>

    <!-- Gaming -->
    <PreferenceCategory
        android:key="category_gaming"
        android:title="@string/category_gaming">

        <Preference
            android:key="pref_game_bar"
            android:title="@string/game_bar_title"
            android:summary="@string/game_bar_summary"
            android:icon="@drawable/ic_game_bar">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="org.settings.oplusparts"
                android:targetClass="org.settings.oplusparts.gamebar.GameBarSettingsActivity" />
        </Preference>
    </PreferenceCategory>

    <!-- Alert Slider -->
    <PreferenceCategory
        android:key="category_alert_slider"
        android:title="@string/category_alert_slider">

        <Preference
            android:key="pref_alert_slider"
            android:title="@string/alert_slider_title"
            android:summary="@string/alert_slider_summary"
            android:icon="@drawable/ic_slider">
            <intent
                android:action="org.lineageos.settings.device.ADDITIONAL_BUTTONS_SETTINGS"
                android:targetPackage="org.lineageos.settings.device"
                android:targetClass="org.lineageos.settings.device.ButtonSettingsActivity" />
        </Preference>
    </PreferenceCategory>

</PreferenceScreen>
