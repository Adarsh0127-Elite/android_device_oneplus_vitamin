<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/refresh_rate_title">

    <PreferenceCategory android:title="@string/refresh_rate_global_title">

        <ListPreference
            android:key="refresh_rate_mode"
            android:icon="@drawable/ic_refresh_rate"
            android:title="@string/refresh_rate_global_title"
            android:entries="@array/refresh_rate_entries"
            android:entryValues="@array/refresh_rate_values"
            android:defaultValue="0" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="refresh_rate_applications"
        android:title="@string/refresh_rate_app_picker_title">

        <Preference
            android:key="refresh_rate_add_packages"
            android:icon="@drawable/ic_add"
            android:title="@string/add_refresh_rate_package_title" />

    </PreferenceCategory>

</PreferenceScreen>
