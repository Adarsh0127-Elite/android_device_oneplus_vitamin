android_app {
    name: "OnePlusParts",
    certificate: "platform",
    defaults: ["SettingsLibDefaults"],
    srcs: ["src/**/*.kt"],
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
    ],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}
